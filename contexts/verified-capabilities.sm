@name verified-capabilities
@version 1.1
@steps [working, done]

[state working]
settings.activated_tools = ["read_file", "inspect_file", "apply_patch", "build_workspace", "run_workspace_tests", "set_context", "get_context", "agent_complete", "read_tool_result"]

[state done]
settings.activated_tools = ["agent_complete", "get_context", "read_tool_result"]

[checks]
# apply_patch uses this named verifier to commit/rollback a source transaction.
build = {"program":"cargo","args":["check","--locked","--workspace"],"cwd":".","timeout_secs":300,"resources":["src","tests","Cargo.toml","Cargo.lock"]}

[action_guards]
done = [verified_rust/build_workspace, verified_rust/run_workspace_tests]
_complete = [verified_rust/build_workspace, verified_rust/run_workspace_tests]
