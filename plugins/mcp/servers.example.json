{
  "servers": {
    "local": {
      "command": "/absolute/path/to/python3",
      "args": ["/absolute/path/to/trusted_mcp_server.py"],
      "cwd": "/absolute/path/to/server-workdir",
      "env_from": {"SERVICE_TOKEN": "mcp_service_token"},
      "allow_tools": ["lookup"],
      "timeout_secs": 20
    }
  }
}
