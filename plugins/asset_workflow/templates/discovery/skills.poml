<poml>
  <!-- User-editable discovery policy. Render ONLY a JSON object, not a persona.
       names: preferred registered names; queries: up to four metadata searches.
       Empty arrays mean no catalog in the prompt, regardless of collection size.
       Use conditions/expressions against user_prompt/settings/custom_data here.
       Hidden skills are always omitted; user_only requires human activation. -->
  <let name="plan" value="({
    instructions: 'Skill discovery is lazy. When a task may benefit from specialized instructions, call search_skills with a few relevant keywords. It searches names and descriptions, never full instructions. Refine the query if necessary; do not enumerate the catalog. Then call use_skill with one matching registered name and its required parameters. A user_only skill must first be selected by the user via /skill or authenticated context controls; ask the user instead of activating it yourself. Hidden dependencies may be loaded by exact name unless user_only. Load dependencies only when the selected workflow needs them. Do not reload instructions already present for this task. Read supporting references only when needed. Follow loaded instructions using normal tools; loading is not completed work and grants no extra permission.',
    names: [],
    queries: [],
    limit: 5
  })" />
  <p>{{JSON.stringify(plan)}}</p>
</poml>
