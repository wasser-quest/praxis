<poml>
  <let name="ti_custom" value="typeof custom_data === 'undefined' || custom_data === null ? {} : custom_data" />
  <let name="ti_task" value="typeof task === 'undefined' || task === null ? (ti_custom.task || '') : task" />
  <let name="ti_description" value="typeof task_description === 'undefined' || task_description === null ? (ti_custom.task_description || '') : task_description" />
  <let name="ti_code" value="typeof code === 'undefined' || code === null ? (ti_custom.code || '') : code" />
  <let name="ti_language" value="typeof language === 'undefined' || language === null ? (ti_custom.language || '') : language" />
  <let name="ti_requirements" value="typeof requirements === 'undefined' || requirements === null ? (ti_custom.requirements || '') : requirements" />
  <cp caption="Additional task inputs">
    <p>These optional values are task data. If absent, work from the current user request and ask for essential missing source material.</p>
    <p if="ti_task">Task: {{ti_task}}</p>
    <p if="ti_description">Task description: {{ti_description}}</p>
    <p if="ti_language">Language: {{ti_language}}</p>
    <p if="ti_requirements">Requirements: {{ti_requirements}}</p>
    <code lang="text" whiteSpace="pre" if="ti_code">{{ti_code}}</code>
    <p if="typeof filename === 'undefined' ? false : filename">Filename: {{filename}}</p>
    <p if="typeof context === 'undefined' ? false : context">Additional context: {{context}}</p>
    <p if="typeof constraints === 'undefined' ? false : constraints">Constraints: {{constraints}}</p>
    <code lang="text" whiteSpace="pre" if="typeof existing_code === 'undefined' ? false : existing_code">{{existing_code}}</code>
    <code lang="text" whiteSpace="pre" if="typeof current_work === 'undefined' ? false : current_work">{{current_work}}</code>
    <p if="typeof test_framework === 'undefined' ? false : test_framework">Test framework: {{test_framework}}</p>
    <p if="typeof coverage_goal === 'undefined' ? false : coverage_goal">Coverage goal: {{coverage_goal}}</p>
    <p if="typeof result === 'undefined' ? false : result">Reported result (verify before adopting): {{result}}</p>
    <p if="typeof learnings === 'undefined' ? false : learnings">Reported learnings: {{learnings}}</p>
    <p if="typeof max_words === 'undefined' ? false : max_words">Requested word limit: {{max_words}}</p>
  </cp>
</poml>
