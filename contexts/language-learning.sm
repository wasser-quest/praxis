@name "Language learning"
@version 1.0
@routing graph
@start setup
@description "Choose a language and goal, teach a small lesson, wait for the learner's answer, give feedback and review. Saved progress requires learner consent."

[tool_groups]
lesson_session = [execute_decision, agent_next, agent_back, get_context, set_context, read_tool_result, memory_get, memory_profile_list]
learning_progress = [memory_profile_create, memory_profile_load, memory_set]

[state setup]
settings.system_template = "language-flow"
settings.use_decision_router = false
settings.max_llm_turns = 1
settings.max_tool_calls = 8
settings.activated_tools = ["lesson_session", "learning_progress"]
[state lesson]
settings.system_template = "language-flow"
settings.use_decision_router = false
settings.max_llm_turns = 1
settings.max_tool_calls = 8
settings.activated_tools = ["lesson_session"]
[state practice]
settings.system_template = "language-flow"
settings.use_decision_router = false
settings.max_llm_turns = 1
settings.max_tool_calls = 8
settings.activated_tools = ["lesson_session"]
[state feedback]
settings.system_template = "language-flow"
settings.use_decision_router = false
settings.max_llm_turns = 1
settings.max_tool_calls = 8
settings.activated_tools = ["lesson_session", "learning_progress"]
[state review]
settings.system_template = "language-flow"
settings.use_decision_router = false
settings.max_llm_turns = 1
settings.max_tool_calls = 8
settings.activated_tools = ["lesson_session", "learning_progress"]
[state done]
settings.system_template = "language-flow"
settings.use_decision_router = false
settings.max_llm_turns = 1
settings.max_tool_calls = 8
settings.activated_tools = ["lesson_session", "agent_complete"]

[node setup]
title = "Choose language and goal"
description = "Ask for missing target language, explanation language, level and goal. Ask separately whether progress should be saved. Teach without saving if consent is absent."
[node lesson]
title = "Small lesson"
description = "Teach one useful concept and a short example suited to the learner. Choose practice when ready, or review to finish."
[node practice]
title = "Ask and wait"
description = "Ask one recall or conversation question and return visible text. Do not supply the learner's answer. Feedback requires a new inbound message while this node is active."
[node feedback]
title = "Feedback on the actual reply"
description = "Use the learner's actual reply, clarify ambiguity and give one correction plus WHY. Feedback is model judgment. Save agreed progress only through confirmed memory results."
[node review]
title = "Review the lesson"
description = "Summarize practiced material and confirmed progress. Offer another question or completion according to the learner's choice."
[node done]
title = "End session"
description = "Use C only when the learner wants to finish. Include a visible recap alongside completion. A later completed session starts at setup."

[transitions]
setup -> lesson
setup -> done
lesson -> practice
lesson -> review
practice -> feedback
practice -> review
feedback -> practice
feedback -> review
review -> practice
review -> done

[edge setup:0]
title = "Start the chosen lesson"
[edge setup:1]
title = "Finish without a lesson"
[edge practice:0]
title = "Respond to the learner"
description = "Requires a new user message received while practice was active, with no subsequent transition."
[edge practice:1]
title = "Review or stop"
[edge feedback:0]
title = "Ask another question"
[edge feedback:1]
title = "Summarize progress"

[decision_ir]
N = agent_next
K = agent_back
[decision_ir done]
C = agent_complete
K = agent_back

# Gateway-observed message/state facts, not a model-written context flag.
[user_reply_guards]
feedback = [practice]
