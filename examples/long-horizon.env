# Opt-in profile for long Thinking/tool tasks. No secrets or provider changes.
# Back up the installation's existing .env, merge these keys only, then restart.
# These are per-LLM-call budgets, NOT a timeout for the entire multi-hour task.
# Bigger output/retry budgets can consume more inference quota. Stop remains active.
# Do not resend old task images on every round; newly read images still work.
LLM_HISTORY_IMAGE_MESSAGES=0
LLM_MAX_OUTPUT_TOKENS=32768
LLM_RETRY_MAX_OUTPUT_TOKENS=65536
LLM_REQUEST_TIMEOUT_MS=600000
LLM_TOTAL_TIMEOUT_MS=1800000
LLM_MAX_ATTEMPTS=5
