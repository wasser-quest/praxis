{
  "name": "legacy_file_ops",
  "description": "Raw read_file/edit_file compatibility tools, installed independently of the Praxis host",
  "version": "0.1.0",
  "enabled": true,
  "replaces": ["legacy_file_ops"],
  "tools": [
    {
      "name": "read_file",
      "description": "Read file contents",
      "parameters": {"type":"object","properties":{"path":{"type":"string"}},"required":["path"]},
      "handler": {"type":"executable","path":"bin/praxis-legacy-file-ops","timeout_secs":30}
    },
    {
      "name": "edit_file",
      "description": "Edit file with find/replace",
      "parameters": {"type":"object","properties":{"path":{"type":"string"},"old_string":{"type":"string"},"new_string":{"type":"string"}},"required":["path","old_string","new_string"]},
      "handler": {"type":"executable","path":"bin/praxis-legacy-file-ops","timeout_secs":30}
    }
  ]
}
